DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
AUTH_SESSION_SECRET="replace-me-with-a-long-random-string"
NEXT_PUBLIC_SITE_URL="https://pwnit-mvp.vercel.app"
APP_URL="https://pwnit-mvp.vercel.app"

# Email OTP is no longer required for this auth patch.
# RESEND_API_KEY and AUTH_EMAIL_FROM can be removed for auth purposes.

# Keep false during MVP/family testing.
# Set true only when you deliberately want BUILDING prize rounds to auto-fail/refund after the funding window.
AUTO_ITEM_EXPIRY_ENABLED="false"

# Email provider (Resend). Leave blank in dev to log codes to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="PwnIt <onboarding@resend.dev>"
